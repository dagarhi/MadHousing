# Plantilla de variables de entorno del backend.
# Copia este fichero a `.env` y rellena los valores reales.
# El `.env` real está en .gitignore y NO debe versionarse.

# ── API de Idealista ──────────────────────────────────────────────────────────
# Credenciales del plan gratuito (100 llamadas/mes). Solo se usan al ejecutar
# `python update_all.py` para refrescar el dataset de viviendas.
IDEALISTA_API_KEY=your_idealista_api_key_here
IDEALISTA_SECRET=your_idealista_secret_here

# ── Autenticación JWT ─────────────────────────────────────────────────────────
# Clave de firma de los tokens. Genera una nueva con:
#   openssl rand -hex 32
JWT_SECRET_KEY=changeme_64_byte_random_hex_string

# ── Cuenta de administración inicial ──────────────────────────────────────────
# `seed_admin()` (main.py) crea esta cuenta con rol ADMIN al arrancar la
# aplicación, si no existe todavía. En producción los valores se inyectan
# desde Secret Manager con credenciales fuertes; en desarrollo local los
# valores de abajo son suficientes para arrancar la app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_strong_password

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# URL del frontend permitida por CORS además de los localhost de desarrollo.
FRONTEND_URL=https://madhousing.netlify.app

# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite (desarrollo rápido, sin extensiones espaciales):
# DATABASE_URL=sqlite:///pisos.db
#
# PostgreSQL local con PostGIS (recomendado, equivalente a producción):
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/madhousing_dev

# ── Migración SQLite → PostgreSQL ─────────────────────────────────────────────
# Solo necesario al ejecutar `python migrate_to_postgres.py`.
# SQLITE_PATH=/ruta/absoluta/al/pisos.db
