# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite (desarrollo local — no hace falta tocar nada):
# DATABASE_URL=sqlite:///pisos.db

# PostgreSQL (producción en Oracle/Neon/etc.):
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/madhousing

# ── Autenticación JWT ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# ── Migración (solo necesario al ejecutar migrate_to_postgres.py) ─────────────
# SQLITE_PATH=/ruta/absoluta/al/pisos.db
