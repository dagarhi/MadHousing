# Plantilla de variables de entorno del frontend.
# Copia este fichero a `.env` y rellena los valores reales.
# El `.env` real está en .gitignore y NO debe versionarse.
#
# Estas variables se inyectan en build-time por @ngx-env/builder.
# Solo se expone al bundle lo que empiece por NG_APP_*.
# Recuerda: cualquier valor aquí acaba en el JS servido al navegador,
# así que NO uses estas variables para secretos verdaderamente sensibles.

# Clave pública de MapTiler para los estilos de mapa (light/dark).
# Obtenla en https://cloud.maptiler.com/account/keys/
NG_APP_MAPTILER_KEY=your_maptiler_key_here

# Clave de OpenRouteService para isócronas y rutas.
# Plan gratuito en https://openrouteservice.org/dev/#/signup
NG_APP_ORS_API_KEY=your_ors_api_key_here
